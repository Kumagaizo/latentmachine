{
  "version": 1,
  "evidenceCases": [
    {
      "id": "challenge-source-disambiguation",
      "expectedChallengeKind": "candidate_disambiguation",
      "expectedInitialStatus": "insufficient",
      "expectedFinalStatus": "safe",
      "expectedFinalOperation": {
        "op": "set",
        "source": "$.a",
        "target": "$.value"
      },
      "answer": {
        "expectedOutput": {
          "value": "A"
        }
      },
      "task": {
        "examples": [
          {
            "input": {
              "a": "X",
              "b": "X"
            },
            "output": {
              "value": "X"
            }
          }
        ],
        "newInput": {
          "a": "A",
          "b": "B"
        }
      }
    },
    {
      "id": "challenge-unseen-value-evidence",
      "expectedChallengeKind": "unseen_value_behavior",
      "expectedInitialStatus": "unsafe",
      "expectedFinalStatus": "safe",
      "expectedFinalOperation": {
        "op": "valueMap",
        "source": "$.status",
        "target": "$.status"
      },
      "answer": {
        "expectedOutput": {
          "status": "B"
        }
      },
      "task": {
        "examples": [
          {
            "input": {
              "status": "new"
            },
            "output": {
              "status": "N"
            }
          },
          {
            "input": {
              "status": "done"
            },
            "output": {
              "status": "D"
            }
          }
        ],
        "newInput": {
          "status": "blocked"
        }
      }
    },
    {
      "id": "challenge-ambiguous-date-evidence",
      "expectedChallengeKind": "ambiguous_date_behavior",
      "expectedInitialStatus": "unsafe",
      "expectedFinalStatus": "safe",
      "answer": {
        "expectedOutput": {
          "created_at": "2024-03-02"
        }
      },
      "task": {
        "examples": [
          {
            "input": {
              "created": "2024/01/05"
            },
            "output": {
              "created_at": "2024-01-05"
            }
          },
          {
            "input": {
              "created": "2023-12-11"
            },
            "output": {
              "created_at": "2023-12-11"
            }
          }
        ],
        "newInput": {
          "created": "02/03/2024"
        }
      }
    }
  ],
  "policyCases": [
    {
      "id": "challenge-unseen-value-policy",
      "expectedChallengeKind": "unseen_value_behavior",
      "policy": "block",
      "task": {
        "examples": [
          {
            "input": {
              "status": "new"
            },
            "output": {
              "status": "N"
            }
          },
          {
            "input": {
              "status": "done"
            },
            "output": {
              "status": "D"
            }
          }
        ],
        "newInput": {
          "status": "blocked"
        }
      }
    }
  ]
}
